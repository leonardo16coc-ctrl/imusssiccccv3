rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /profiles/{uid} {
   allow read: if true;
   allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.id == uid
    && request.resource.data.keys().hasOnly(['id','artistName','tagline','bio','location','genre','website','appleMusicUrl','avatar','banner','background','theme','button','secondaryButton','buttonText','modules','stickers']);
   allow update: if request.auth != null && request.auth.uid == uid && request.resource.data.id == uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['artistName','tagline','bio','location','genre','website','appleMusicUrl','avatar','banner','background','theme','button','secondaryButton','buttonText','modules','stickers']);
  }
  match /videos/{id} {
   allow read: if true;
   allow create: if request.auth != null && request.resource.data.artistId == request.auth.uid
    && request.resource.data.id == id
    && request.resource.data.keys().hasOnly(['id','artistId','artistName','title','description','genre','thumbnail','duration','views','likes','videoUrl','storagePath','createdAt'])
    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
    && request.resource.data.views == 0 && request.resource.data.likes == 0;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
