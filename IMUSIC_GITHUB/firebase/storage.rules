rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /users/{uid}/{kind}/{file} {
   allow read: if true;
   allow create: if request.auth != null && request.auth.uid == uid &&
    ((kind == 'videos' && request.resource.size < 201 * 1024 * 1024 && request.resource.contentType.matches('video/(mp4|webm|quicktime)')) ||
     (kind == 'images' && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)')));
   allow delete: if request.auth != null && request.auth.uid == uid;
  }
 }
}
